{
  "formatVersion": 1,
  "id": "score_report",
  "version": 1,
  "kind": "program",
  "metadata": {
    "name": "Score Report",
    "description": "演示常量、数学、变量、条件分支、函数调用与返回值的最小完整蓝图。",
    "variables": [
      {"name": "score", "type": "int64", "initialValue": 72},
      {"name": "passing", "type": "int64", "initialValue": 60},
      {"name": "message", "type": "string", "initialValue": "failed"},
      {"name": "bonus", "type": "int64", "initialValue": 0},
      {"name": "total", "type": "int64", "initialValue": 0}
    ],
    "imports": [],
    "functions": []
  },
  "nodes": [
    {"id": "entry", "type": "Entry", "position": {"x": 0, "y": 0}, "params": {"name": "mio_graph_main"}},
    {"id": "seq", "type": "Sequence", "position": {"x": 240, "y": 0}, "params": {"branches": 3}},
    {"id": "set_bonus", "type": "VariableSet", "position": {"x": 480, "y": 0}, "params": {"variable": "bonus"}},
    {"id": "set_total", "type": "VariableSet", "position": {"x": 720, "y": 0}, "params": {"variable": "total"}},
    {"id": "add_bonus", "type": "Add", "position": {"x": 240, "y": 160}, "params": {}},
    {"id": "var_score_a", "type": "VariableGet", "position": {"x": 0, "y": 160}, "params": {"variable": "score"}},
    {"id": "const_five", "type": "Constant", "position": {"x": 0, "y": 240}, "params": {"type": "int64", "value": 5}},
    {"id": "mul_total", "type": "Multiply", "position": {"x": 480, "y": 160}, "params": {}},
    {"id": "var_bonus", "type": "VariableGet", "position": {"x": 240, "y": 240}, "params": {"variable": "bonus"}},
    {"id": "const_two", "type": "Constant", "position": {"x": 240, "y": 320}, "params": {"type": "int64", "value": 2}},
    {"id": "branch", "type": "Branch", "position": {"x": 960, "y": 0}, "params": {}},
    {"id": "gt", "type": "GreaterThan", "position": {"x": 720, "y": 160}, "params": {}},
    {"id": "var_score_b", "type": "VariableGet", "position": {"x": 480, "y": 240}, "params": {"variable": "score"}},
    {"id": "var_passing", "type": "VariableGet", "position": {"x": 480, "y": 320}, "params": {"variable": "passing"}},
    {"id": "set_message", "type": "VariableSet", "position": {"x": 1200, "y": -120}, "params": {"variable": "message"}},
    {"id": "const_passed", "type": "Constant", "position": {"x": 960, "y": -120}, "params": {"type": "string", "value": "passed"}},
    {"id": "chant_message_true", "type": "FunctionCall", "position": {"x": 1440, "y": -120}, "params": {"function": "chant"}},
    {"id": "chant_total", "type": "FunctionCall", "position": {"x": 1680, "y": -120}, "params": {"function": "chant"}},
    {"id": "var_message", "type": "VariableGet", "position": {"x": 1200, "y": -240}, "params": {"variable": "message"}},
    {"id": "var_total", "type": "VariableGet", "position": {"x": 1440, "y": -240}, "params": {"variable": "total"}},
    {"id": "return_true", "type": "Return", "position": {"x": 1920, "y": -120}, "params": {}},
    {"id": "chant_message_false", "type": "FunctionCall", "position": {"x": 1200, "y": 120}, "params": {"function": "chant"}},
    {"id": "return_false", "type": "Return", "position": {"x": 1440, "y": 120}, "params": {}}
  ],
  "connections": [
    {"id": "c_seq_set_bonus", "from": {"nodeId": "seq", "pinId": "seq.then_0"}, "to": {"nodeId": "set_bonus", "pinId": "set_bonus.exec_in"}},
    {"id": "c_seq_set_total", "from": {"nodeId": "seq", "pinId": "seq.then_1"}, "to": {"nodeId": "set_total", "pinId": "set_total.exec_in"}},
    {"id": "c_seq_branch", "from": {"nodeId": "seq", "pinId": "seq.then_2"}, "to": {"nodeId": "branch", "pinId": "branch.exec_in"}},
    {"id": "c_entry_seq", "from": {"nodeId": "entry", "pinId": "entry.exec_out"}, "to": {"nodeId": "seq", "pinId": "seq.exec_in"}},
    {"id": "c_add_value", "from": {"nodeId": "add_bonus", "pinId": "add_bonus.result"}, "to": {"nodeId": "set_bonus", "pinId": "set_bonus.value"}},
    {"id": "c_add_a", "from": {"nodeId": "var_score_a", "pinId": "var_score_a.value"}, "to": {"nodeId": "add_bonus", "pinId": "add_bonus.a"}},
    {"id": "c_add_b", "from": {"nodeId": "const_five", "pinId": "const_five.value"}, "to": {"nodeId": "add_bonus", "pinId": "add_bonus.b"}},
    {"id": "c_mul_value", "from": {"nodeId": "mul_total", "pinId": "mul_total.result"}, "to": {"nodeId": "set_total", "pinId": "set_total.value"}},
    {"id": "c_mul_a", "from": {"nodeId": "var_bonus", "pinId": "var_bonus.value"}, "to": {"nodeId": "mul_total", "pinId": "mul_total.a"}},
    {"id": "c_mul_b", "from": {"nodeId": "const_two", "pinId": "const_two.value"}, "to": {"nodeId": "mul_total", "pinId": "mul_total.b"}},
    {"id": "c_gt_condition", "from": {"nodeId": "gt", "pinId": "gt.result"}, "to": {"nodeId": "branch", "pinId": "branch.condition"}},
    {"id": "c_gt_a", "from": {"nodeId": "var_score_b", "pinId": "var_score_b.value"}, "to": {"nodeId": "gt", "pinId": "gt.a"}},
    {"id": "c_gt_b", "from": {"nodeId": "var_passing", "pinId": "var_passing.value"}, "to": {"nodeId": "gt", "pinId": "gt.b"}},
    {"id": "c_branch_true", "from": {"nodeId": "branch", "pinId": "branch.true"}, "to": {"nodeId": "set_message", "pinId": "set_message.exec_in"}},
    {"id": "c_set_message_chant", "from": {"nodeId": "set_message", "pinId": "set_message.exec_out"}, "to": {"nodeId": "chant_message_true", "pinId": "chant_message_true.exec_in"}},
    {"id": "c_chant_message_total", "from": {"nodeId": "chant_message_true", "pinId": "chant_message_true.exec_out"}, "to": {"nodeId": "chant_total", "pinId": "chant_total.exec_in"}},
    {"id": "c_chant_total_return", "from": {"nodeId": "chant_total", "pinId": "chant_total.exec_out"}, "to": {"nodeId": "return_true", "pinId": "return_true.exec_in"}},
    {"id": "c_passed_value", "from": {"nodeId": "const_passed", "pinId": "const_passed.value"}, "to": {"nodeId": "set_message", "pinId": "set_message.value"}},
    {"id": "c_message_true_arg", "from": {"nodeId": "var_message", "pinId": "var_message.value"}, "to": {"nodeId": "chant_message_true", "pinId": "chant_message_true.arg_0"}},
    {"id": "c_total_arg", "from": {"nodeId": "var_total", "pinId": "var_total.value"}, "to": {"nodeId": "chant_total", "pinId": "chant_total.arg_0"}},
    {"id": "c_branch_false", "from": {"nodeId": "branch", "pinId": "branch.false"}, "to": {"nodeId": "chant_message_false", "pinId": "chant_message_false.exec_in"}},
    {"id": "c_chant_false_return", "from": {"nodeId": "chant_message_false", "pinId": "chant_message_false.exec_out"}, "to": {"nodeId": "return_false", "pinId": "return_false.exec_in"}},
    {"id": "c_message_false_arg", "from": {"nodeId": "var_message", "pinId": "var_message.value"}, "to": {"nodeId": "chant_message_false", "pinId": "chant_message_false.arg_0"}}
  ]
}
